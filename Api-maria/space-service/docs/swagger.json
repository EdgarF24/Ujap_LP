    "definitions": {
        "models.SpaceType": {
            "type": "string",
            "enum": [
                "DESK",
                "OFFICE",
                "MEETING_ROOM",
                "LOUNGE"
            ],
            "x-enum-varnames": [
                "SpaceTypeDesk",
                "SpaceTypeOffice",
                "SpaceTypeMeetingRoom",
                "SpaceTypeLounge"
            ]
        },
        "services.CreateInvoiceInput": {
            "type": "object",
            "required": [
                "amount",
                "due_at",
                "reservation_id",
                "user_id"
            ],
            "properties": {
                "amount": {
                    "type": "number"
                },
                "due_at": {
                    "type": "string"
                },
                "issued_at": {
                    "type": "string"
                },
                "reservation_id": {
                    "type": "string"
                },
                "user_id": {
                    "type": "string"
                }
            }
        },
        "services.CreateSpaceInput": {
            "type": "object",
            "required": [
                "capacity",
                "name",
                "price_per_hour",
                "type"
            ],
            "properties": {
                "amenities": {
                    "type": "string"
                },
                "capacity": {
                    "type": "integer",
                    "minimum": 1
                },
                "name": {
                    "type": "string"
                },
                "price_per_hour": {
                    "type": "number"
                },
                "type": {
